+        SaveFixture(std::string(base)+std::to_string(fixtureN)+".out",cpu,workRAM,mainRAM,frameNumber,0,unused);
+        if (response) std::fprintf(g_indyLab,"FIXTURE_RESPONSE %d %llu candidate=%08x path=21dc8,21e28,20ec4,20ed0\n",fixtureN,(unsigned long long)frameNumber,fixtureCandidate);
