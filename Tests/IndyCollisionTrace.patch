+    FILE* f = std::fopen(name, "w");
+    if (f) {
+      for (size_t i = 0; i < hits.size(); ++i)
+        if (hits[i]) std::fprintf(f, "%06zx %u\n", i * 4, hits[i]);
+      std::fclose(f);
+    }
+    std::snprintf(name, sizeof name, "%s_%04d.ram", snapBase, snapN);
+    f = std::fopen(name, "wb");
+    if (f) {
+      // actor table (0x3c000-0x3e000) and the flag area (0x44000-0x44800), work RAM offsets
+      if (ram->size() >= 0x44800) {
+        std::fwrite(ram->data() + 0x3c000, 1, 0x2000, f);
+        std::fwrite(ram->data() + 0x44000, 1, 0x800, f);
+      }
+      std::fclose(f);
+    }
+    ++snapN;
+  }
