+      fixturePeerSeen=fixtureFlagSeen=fixtureReturned=false;
+      fixturePhysicsRead=fixturePhysicsCall=fixtureX=fixtureZ=false; fixtureCandidate=0;
+      SaveFixture(std::string(base)+std::to_string(fixtureN)+".in",cpu,workRAM,mainRAM,frameNumber,actor,pose);
+      g_fixtureIO=std::fopen((std::string(base)+std::to_string(fixtureN)+".io").c_str(),"w");
+      if (!g_fixtureIO) { std::fprintf(g_indyLab,"FIXTURE_IO_OPEN_FAILED\n"); std::fflush(g_indyLab); return; }
+      if (std::getenv("SUPERMODEL_INDY_LAB_COMM_FIXTURE")) {
