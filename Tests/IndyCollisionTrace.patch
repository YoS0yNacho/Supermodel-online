+// Diagnostic PC histogram (SUPERMODEL_I960_PCHIT=<file>): written on SIGTERM.
+#include <csignal>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+namespace I960PcHit {
+  static std::vector<uint32_t> hits(0x1000000 / 4, 0);
+  static const char* path = nullptr;
+  static void Dump() {
+    if (!path) return;
+    FILE* f = std::fopen(path, "w");
+    if (!f) return;
+    for (size_t i = 0; i < hits.size(); ++i)
+      if (hits[i]) std::fprintf(f, "%06zx %u\n", i * 4, hits[i]);
