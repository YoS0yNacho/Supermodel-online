+      if (ip==0xac230) { fixtureOuterReturn=cpu.GetReg(CI960::REG_RIP); fixtureOuterFrame=frameNumber; }
+      if (peerOnly && (frameNumber<fixtureOuterFrame || frameNumber-fixtureOuterFrame>1)) return;
