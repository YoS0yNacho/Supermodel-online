+  static bool fixtureWaiting=false;
+  static uint32_t fixtureReturn=0, fixtureOuterReturn=0;
+  static uint64_t fixtureLast=0, fixtureOuterFrame=0;
+  static uint64_t fixtureStartFrame=0, fixtureLastAttempt=0;
+  static uint32_t fixtureDetectorReturn=0, fixtureCandidate=0;
+  static unsigned fixtureActor=0;
+  static bool fixturePeerSeen=false, fixtureFlagSeen=false, fixtureReturned=false;
+  static bool fixturePhysicsRead=false, fixturePhysicsCall=false, fixtureX=false, fixtureZ=false;
+  static bool fixtureProgramSaved=false;
+  static std::function<void(CBlockFile*)> fixtureSaveDevices;
+  static void SaveFixture(const std::string &file, CI960 &cpu,
+                          std::vector<uint8_t> &work, std::vector<uint8_t> &main,
+                          uint64_t frame, unsigned actor, const IndyLocalCollisionLab::Sample &pose) {
+    CBlockFile b;
+    if (Result::OKAY!=b.Create(file,"Indy collision fixture","lab data; do not distribute")) return;
+    b.NewBlock("Fixture metadata", "v1");
+    uint32_t version=1, returnPC=fixtureReturn, valid=pose.valid, reset=pose.reset;
+    b.Write(version); b.Write(frame); b.Write(actor); b.Write(returnPC);
+    b.Write(valid); b.Write(reset); b.Write(pose.now.x); b.Write(pose.now.z);
+    b.Write(pose.previous.x); b.Write(pose.previous.z);
+    b.NewBlock("Fixture main RAM", "");
+    uint32_t size=main.size(); b.Write(size); b.Write(main.data(),size);
+    b.NewBlock("Fixture work RAM", "");
+    size=work.size(); b.Write(size); b.Write(work.data(),size);
+    cpu.SaveState(&b,"Fixture i960");
+    if (std::getenv("SUPERMODEL_INDY_LAB_SHARC_FIXTURE") && fixtureSaveDevices) fixtureSaveDevices(&b);
+    b.Close();
